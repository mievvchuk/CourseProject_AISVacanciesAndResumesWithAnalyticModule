@model ResumeDetailsViewModel

@{
    ViewData["Title"] = "Деталі резюме";

    string Show(string? value, string fallback = "Не вказано")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    var salary = Model.DesiredSalary.HasValue
        ? $"{Model.DesiredSalary.Value:N0} грн"
        : "Не вказано";

    var skills = Model.SkillNames.Any()
        ? Model.SkillNames
        : new List<string>();

    var fileSize = Model.FileSize.HasValue
        ? $"{Math.Round(Model.FileSize.Value / 1024.0, 1)} КБ"
        : "Розмір не вказано";
}

<section class="resume-details-page">
    <div class="resume-details-card card shadow-sm border-0">
        <div class="resume-details-cover"></div>

        <div class="card-body">
            <div class="resume-details-head">
                <div>
                    <div class="resume-details-eyebrow">Моє резюме</div>
                    <h1>@Show(Model.Title, "Резюме")</h1>
                    <div class="resume-details-subtitle">
                        <i class="ti ti-user"></i>
                        <span>@Show(Model.FullName)</span>
                    </div>
                </div>

                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i>
                    Редагувати
                </a>
            </div>

            <div class="resume-details-metrics">
                <div class="resume-details-metric">
                    <i class="ti ti-category"></i>
                    <span>Категорія</span>
                    <strong>@Show(Model.CategoryName)</strong>
                </div>

                <div class="resume-details-metric">
                    <i class="ti ti-briefcase"></i>
                    <span>Бажана посада</span>
                    <strong>@Show(Model.DesiredPosition)</strong>
                </div>

                <div class="resume-details-metric">
                    <i class="ti ti-chart-bar"></i>
                    <span>Досвід</span>
                    <strong>@Model.ExperienceLevel.GetDisplayName() · @Model.ExperienceYears років</strong>
                </div>

                <div class="resume-details-metric">
                    <i class="ti ti-currency-hryvnia"></i>
                    <span>Бажана зарплата</span>
                    <strong>@salary</strong>
                </div>
            </div>

            <div class="resume-details-status-row">
                <span class="badge bg-blue-lt text-blue">
                    Статус: @Model.Status.GetDisplayName()
                </span>

                @if (Model.IsPublished)
                {
                    <span class="badge bg-green-lt text-green">
                        <i class="ti ti-check me-1"></i>
                        Опубліковано
                    </span>
                }
                else
                {
                    <span class="badge bg-yellow-lt text-yellow">
                        <i class="ti ti-clock me-1"></i>
                        Не опубліковано
                    </span>
                }
            </div>

            <div class="resume-details-layout">
                <div class="resume-details-main">
                    <section class="resume-details-section">
                        <h2>Короткий опис</h2>
                        <p>@Show(Model.Summary, "Короткий опис ще не додано.")</p>
                    </section>

                    <section class="resume-details-section">
                        <h2>Освіта</h2>
                        <p>@Show(Model.Education, "Інформацію про освіту ще не додано.")</p>
                    </section>

                    <section class="resume-details-section">
                        <h2>Досвід роботи</h2>
                        <p>@Show(Model.Experience, "Опис досвіду ще не додано.")</p>
                    </section>

                    <section class="resume-details-section">
                        <h2>Навички</h2>

                        @if (skills.Any())
                        {
                            <div class="resume-details-skills">
                                @foreach (var skill in skills)
                                {
                                    <span class="badge bg-secondary-lt">@skill</span>
                                }
                            </div>
                        }
                        else
                        {
                            <p>Навички ще не додано.</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.SkillsDescription))
                        {
                            <p class="mt-3">@Model.SkillsDescription</p>
                        }
                    </section>
                </div>

                <aside class="resume-details-sidebar">
                    <section class="resume-details-section">
                        <h2>Параметри</h2>

                        <dl class="resume-details-list">
                            <div>
                                <dt>Тип зайнятості</dt>
                                <dd>@Model.EmploymentType.GetDisplayName()</dd>
                            </div>

                            <div>
                                <dt>Рівень досвіду</dt>
                                <dd>@Model.ExperienceLevel.GetDisplayName()</dd>
                            </div>

                            <div>
                                <dt>Роки досвіду</dt>
                                <dd>@Model.ExperienceYears</dd>
                            </div>

                            <div>
                                <dt>Рівень освіти</dt>
                                <dd>@Model.EducationLevel.GetDisplayName()</dd>
                            </div>

                            <div>
                                <dt>Бажана зарплата</dt>
                                <dd>@salary</dd>
                            </div>
                        </dl>
                    </section>

                    <section class="resume-details-section">
                        <h2>Завантажений файл</h2>

                        @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                        {
                            <a href="@Model.FilePath"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="btn btn-outline-primary w-100">
                                <i class="ti ti-file-download me-1"></i>
                                Відкрити файл
                            </a>

                            <div class="text-secondary small mt-2">
                                <div>@Show(Model.OriginalFileName)</div>
                                <div>@Show(Model.ContentType)</div>
                                <div>@fileSize</div>

                                @if (Model.UploadedAt.HasValue)
                                {
                                    <div>Завантажено: @Model.UploadedAt.ToKyivString()</div>
                                }
                            </div>
                        }
                        else
                        {
                            <p>Файл не завантажено.</p>
                        }
                    </section>
                </aside>
            </div>
        </div>
    </div>
</section>