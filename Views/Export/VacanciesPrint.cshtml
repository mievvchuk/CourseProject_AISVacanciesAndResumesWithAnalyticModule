@model VacancyIndexViewModel

@{
    Layout = null;
    var generatedAt = DateTime.UtcNow.ToKyivString();
}

<!doctype html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Експорт вакансій у PDF</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            padding: 32px;
            color: #172033;
            font-family: "DejaVu Sans", "Segoe UI", Arial, sans-serif;
            background: #f4f7fb;
        }
        .sheet {
            max-width: 1120px;
            margin: 0 auto;
            padding: 28px;
            background: #fff;
            border: 1px solid #d9e2ef;
        }
        .toolbar {
            max-width: 1120px;
            margin: 0 auto 16px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }
        button, a {
            padding: 10px 14px;
            border: 1px solid #0d6efd;
            border-radius: 6px;
            background: #0d6efd;
            color: #fff;
            text-decoration: none;
            font: inherit;
            cursor: pointer;
        }
        a {
            background: #fff;
            color: #0d6efd;
        }
        h1 {
            margin: 0 0 4px;
            font-size: 28px;
        }
        .muted {
            color: #607089;
            margin-bottom: 24px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }
        th, td {
            padding: 10px 8px;
            border-bottom: 1px solid #e5eaf2;
            text-align: left;
            vertical-align: top;
        }
        th {
            color: #3c4a60;
            background: #f6f8fb;
            font-weight: 700;
        }
        .skills {
            color: #4f5f75;
            font-size: 12px;
        }
        @@media print {
            body { padding: 0; background: #fff; }
            .toolbar { display: none; }
            .sheet { max-width: none; border: 0; padding: 0; }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
        }
        @@media (max-width: 767.98px) {
            body { padding: 12px; }
            .toolbar { align-items: stretch; flex-direction: column; }
            button, a { width: 100%; text-align: center; }
            .sheet { padding: 16px; overflow-x: auto; }
            h1 { font-size: 22px; }
            table { min-width: 760px; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <a asp-controller="Vacancies" asp-action="Index">Назад</a>
        <button type="button" onclick="window.print()">Зберегти як PDF</button>
    </div>

    <main class="sheet">
        <h1>Звіт за вакансіями</h1>
        <div class="muted">Сформовано: @generatedAt</div>

        @if (!Model.Items.Any())
        {
            <p>За вибраними фільтрами вакансій не знайдено.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Назва</th>
                        <th>Компанія</th>
                        <th>Категорія</th>
                        <th>Місто</th>
                        <th>Зайнятість</th>
                        <th>Досвід</th>
                        <th>Зарплата</th>
                        <th>Статус</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var vacancy in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@vacancy.Title</strong>
                                @if (vacancy.Skills.Any())
                                {
                                    <div class="skills">@string.Join(", ", vacancy.Skills)</div>
                                }
                            </td>
                            <td>@vacancy.CompanyName</td>
                            <td>@vacancy.CategoryName</td>
                            <td>@vacancy.City</td>
                            <td>@vacancy.EmploymentType.GetDisplayName()</td>
                            <td>@vacancy.ExperienceLevel.GetDisplayName()</td>
                            <td>@vacancy.SalaryFrom - @vacancy.SalaryTo грн</td>
                            <td>@vacancy.Status.GetDisplayName()</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </main>

    <script>
        window.addEventListener('load', function () {
            window.print();
        });
    </script>
</body>
</html>
