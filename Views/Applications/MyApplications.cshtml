@model AisVacanciesAndResumes.ViewModels.Applications.MyApplicationsIndexViewModel

@{
    ViewData["Title"] = "Мої заявки";
}

@functions {
    private static string GetStatusClass(ApplicationStatus status)
    {
        return status switch
        {
            ApplicationStatus.New => "bg-primary-lt text-primary",
            ApplicationStatus.Reviewed => "bg-cyan-lt text-cyan",
            ApplicationStatus.Accepted => "bg-green-lt text-green",
            ApplicationStatus.Rejected => "bg-red-lt text-red",
            _ => "bg-secondary-lt text-secondary"
        };
    }

    private static string GetStatusMessage(ApplicationStatus status)
    {
        return status switch
        {
            ApplicationStatus.New => "Заявку надіслано роботодавцю.",
            ApplicationStatus.Reviewed => "Роботодавець переглянув вашу заявку.",
            ApplicationStatus.Accepted => "Заявку прийнято. Очікуйте подальший контакт від роботодавця.",
            ApplicationStatus.Rejected => "На жаль, заявку відхилено.",
            _ => "Статус заявки оновлено."
        };
    }
}

<section class="my-applications-page">
    <div class="mb-4">
        <h1 class="h3 mb-1">Мої заявки</h1>
        <p class="text-secondary mb-0">Відстежуйте статуси відгуків на вакансії.</p>
    </div>

    <form asp-action="MyApplications" method="get" class="card application-filter-card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Filter.VacancyTitle" class="form-label">Пошук за назвою</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input asp-for="Filter.VacancyTitle" name="VacancyTitle" class="form-control" placeholder="Назва вакансії..." />
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Filter.Status" class="form-label">Статус заявки</label>
                    <select asp-for="Filter.Status" name="Status" class="form-select">
                        <option value="">Всі статуси</option>
                        @foreach (var status in Enum.GetValues<ApplicationStatus>())
                        {
                            <option value="@status">@status.GetDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="Filter.CompanyName" class="form-label">Компанія</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-building"></i>
                        </span>
                        <input asp-for="Filter.CompanyName" name="CompanyName" class="form-control" placeholder="Назва компанії..." />
                    </div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Filter.SubmittedFrom" class="form-label">Дата подання</label>
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-calendar"></i>
                        </span>
                        <input asp-for="Filter.SubmittedFrom" name="SubmittedFrom" type="date" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-search me-1"></i>
                    Знайти
                </button>
                <a asp-action="MyApplications" class="btn btn-outline-secondary">
                    <i class="ti ti-x me-1"></i>
                    Очистити
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="application-empty card shadow-sm border-0">
            <div class="card-body">
                <div class="feature-icon bg-primary-lt text-primary mb-3">
                    <i class="ti ti-send-off"></i>
                </div>
                <h2 class="h4 mb-2">Заявок немає</h2>
                <p class="text-secondary mb-4">Коли ви подасте заявку на вакансію, вона з'явиться тут.</p>
                <a asp-controller="Vacancies" asp-action="Index" class="btn btn-primary">Знайти вакансії</a>
            </div>
        </div>
    }
    else
    {
        <div class="application-list">
            @foreach (var item in Model.Items)
            {
                <article class="card application-card shadow-sm border-0">
                    <div class="card-body">
                        <div class="application-card-header">
                            <div>
                                <h2>@item.VacancyTitle</h2>
                                <div class="application-meta">
                                    <span><i class="ti ti-briefcase"></i>@item.CompanyName</span>
                                    <span><i class="ti ti-calendar"></i>@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                                    <span><i class="ti ti-file-text"></i>@item.ResumeTitle</span>
                                </div>
                            </div>
                            <span class="badge @GetStatusClass(item.Status)">@item.Status.GetDisplayName()</span>
                        </div>

                        <div class="application-note">
                            @GetStatusMessage(item.Status)
                        </div>

                        <div class="application-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                                <i class="ti ti-eye me-1"></i>
                                Деталі
                            </a>
                            <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@item.VacancyId" class="btn btn-outline-secondary">
                                <i class="ti ti-external-link me-1"></i>
                                Вакансія
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>
