@model List<AisVacanciesAndResumes.ViewModels.Applications.ApplicationListItemViewModel>

@{
    ViewData["Title"] = "Усі заявки";

    static string GetStatusClass(ApplicationStatus status)
    {
        return status switch
        {
            ApplicationStatus.New => "bg-primary-lt text-primary",
            ApplicationStatus.Reviewed => "bg-cyan-lt text-cyan",
            ApplicationStatus.Accepted => "bg-green-lt text-green",
            ApplicationStatus.Rejected => "bg-red-lt text-red",
            _ => "bg-secondary-lt text-secondary"
        };
    }
}

<div class="applications-page">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <h2 class="h3 mb-1">Усі заявки</h2>
            <div class="text-secondary">Переглядайте відгуки кандидатів тільки на ваші вакансії.</div>
        </div>
        <a asp-controller="Vacancies" asp-action="My" class="btn btn-outline-primary">
            <i class="ti ti-briefcase me-1"></i>Мої вакансії
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <div class="feature-icon bg-primary-lt text-primary mx-auto mb-3"><i class="ti ti-inbox"></i></div>
                <h3 class="h4 mb-2">Заявок поки немає</h3>
                <p class="text-secondary mb-0">Заявок на ваші вакансії поки немає.</p>
            </div>
        </div>
    }
    else
    {
        <div class="application-list">
            @foreach (var item in Model)
            {
                <article class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-3">
                            <div>
                                <h3 class="h5 mb-2">@item.VacancyTitle</h3>
                                <div class="d-flex flex-wrap gap-3 text-secondary">
                                    <span><i class="ti ti-user me-1"></i>@item.CandidateFullName</span>
                                    <span><i class="ti ti-file-text me-1"></i>@item.ResumeTitle</span>
                                    <span><i class="ti ti-calendar me-1"></i>@item.CreatedAt.ToKyivString()</span>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge @GetStatusClass(item.Status)">@item.Status.GetDisplayName()</span>
                                <div class="mt-2 text-secondary">Відповідність: <strong>@item.MatchingPercent%</strong></div>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary">
                                <i class="ti ti-eye me-1"></i>Деталі заявки
                            </a>
                            <a asp-controller="EmployerCandidates" asp-action="Details" asp-route-id="@item.ResumeId" class="btn btn-outline-secondary">
                                <i class="ti ti-file-search me-1"></i>Резюме кандидата
                            </a>
                            <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@item.VacancyId" class="btn btn-outline-secondary">
                                <i class="ti ti-briefcase me-1"></i>Вакансія
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
