@model EmployerProfileFormViewModel

@{
    ViewData["Title"] = "Редагування профілю роботодавця";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <form asp-action="Edit" method="post" enctype="multipart/form-data" class="profile-edit-card card shadow-sm border-0 js-profile-image-form">
            <input asp-for="Id" type="hidden" />
            <div class="profile-cover employer-profile-cover"></div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="profile-edit-header">
                    <div class="profile-avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                        {
                            <img src="@Model.LogoPath" alt="Логотип компанії" class="profile-avatar js-profile-image-preview" onerror="this.classList.add('d-none'); this.nextElementSibling?.classList.remove('d-none');" />
                            <div class="profile-avatar profile-avatar-placeholder js-profile-image-fallback d-none"><i class="ti ti-building"></i></div>
                        }
                        else
                        {
                            <div class="profile-avatar profile-avatar-placeholder js-profile-image-preview"><i class="ti ti-building"></i></div>
                        }
                    </div>
                    <div class="profile-edit-heading">
                        <h2 class="h4 mb-1">Редагування профілю роботодавця</h2>
                        <div class="text-secondary">@(!string.IsNullOrWhiteSpace(Model.CompanyName) ? Model.CompanyName : "Заповніть інформацію про компанію")</div>
                    </div>
                </div>

                <div class="profile-section">
                    <h3 class="profile-section-title">Основна інформація</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">Назва компанії</label>
                            <input asp-for="CompanyName" class="form-control" />
                            <span asp-validation-for="CompanyName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LogoFile" class="form-label">Логотип компанії</label>
                            @if (!string.IsNullOrWhiteSpace(Model.LogoPath))
                            {
                                <div class="profile-file-state"><i class="ti ti-check"></i> Логотип уже додано. Виберіть новий файл, щоб замінити.</div>
                            }
                            <input asp-for="LogoFile" class="form-control js-profile-image-input" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
                            <span asp-validation-for="LogoFile" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <div class="profile-crop-panel js-profile-crop-panel d-none">
                                <div class="profile-crop-box"><img class="js-profile-crop-image" alt="Попередній перегляд логотипа" /></div>
                                <div class="profile-crop-controls">
                                    <label class="form-label">Масштаб</label>
                                    <input class="form-range js-profile-crop-zoom" type="range" min="1" max="2.5" step="0.05" value="1" />
                                    <label class="form-label">Положення по горизонталі</label>
                                    <input class="form-range js-profile-crop-x" type="range" min="0" max="100" value="50" />
                                    <label class="form-label">Положення по вертикалі</label>
                                    <input class="form-range js-profile-crop-y" type="range" min="0" max="100" value="50" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Industry" class="form-label">Галузь</label>
                            <input asp-for="Industry" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Website" class="form-label">Сайт</label>
                            <input asp-for="Website" class="form-control" />
                        </div>
                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Опис компанії</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="profile-section">
                    <h3 class="profile-section-title">Параметри компанії</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="CompanySize" class="form-label">Розмір компанії</label>
                            <input asp-for="CompanySize" class="form-control" placeholder="Наприклад: 50-100" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FoundedYear" class="form-label">Рік заснування</label>
                            <input asp-for="FoundedYear" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="City" class="form-label">Місто</label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Location" class="form-label">Локація</label>
                            <input asp-for="Location" class="form-control" placeholder="Адреса або район офісу" />
                        </div>
                    </div>
                </div>

                <div class="profile-actions">
                    <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Зберегти зміни</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/profile-image-crop.js" asp-append-version="true"></script>
}
