@model AisVacanciesAndResumes.ViewModels.Admin.AdminUserIndexViewModel

@{
    ViewData["Title"] = "Користувачі";
}

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h3 class="card-title mb-1">Керування користувачами</h3>
            <div class="text-secondary">Знайдено: @Model.Items.Count</div>
        </div>
    </div>
    <div class="card-body border-bottom">
        <form asp-action="Users" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="admin-user-search">Пошук</label>
                <input id="admin-user-search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="ПІБ або електронна пошта" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="admin-user-role">Роль</label>
                <select id="admin-user-role" name="RoleName" class="form-select">
                    <option value="">Усі ролі</option>
                    <option value="Candidate" selected="@(Model.Filter.RoleName == "Candidate")">Кандидат</option>
                    <option value="Employer" selected="@(Model.Filter.RoleName == "Employer")">Роботодавець</option>
                    <option value="Admin" selected="@(Model.Filter.RoleName == "Admin")">Адміністратор</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="admin-user-active">Стан</label>
                <select id="admin-user-active" name="IsActive" class="form-select">
                    <option value="">Усі</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Активні</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Деактивовані</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Знайти
                </button>
                <a asp-action="Users" class="btn btn-outline-secondary" title="Очистити">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
    <div class="card-body p-0">
        @if (!Model.Items.Any())
        {
            <div class="admin-empty-state">
                <i class="bi bi-people"></i>
                <h2>Користувачів немає</h2>
                <p>Після реєстрації користувачі з'являться у цьому списку.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>ПІБ</th>
                            <th>Email</th>
                            <th>Роль</th>
                            <th>Стан</th>
                            <th>Створено</th>
                            <th class="text-end">Дії</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold">@item.FullName</td>
                                <td>@item.Email</td>
                                <td><span class="badge text-bg-light">@item.RoleName</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge text-bg-success">Активний</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">Деактивований</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToKyivString()</td>
                                <td class="text-end">
                                    @if (item.IsActive)
                                    {
                                        <form asp-action="DeactivateUser" method="post" class="admin-inline-action"
                                              data-confirm
                                              data-confirm-title="Деактивувати користувача?"
                                              data-confirm-message="Користувач втратить доступ до облікового запису, доки його знову не активують."
                                              data-confirm-submit="Деактивувати">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="text" name="comment" class="form-control form-control-sm" placeholder="Коментар" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-person-x me-1"></i>Деактивувати
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ActivateUser" method="post" class="admin-inline-action"
                                              data-confirm
                                              data-confirm-title="Активувати користувача?"
                                              data-confirm-message="Користувач знову отримає доступ до облікового запису."
                                              data-confirm-submit="Активувати"
                                              data-confirm-variant="success">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="text" name="comment" class="form-control form-control-sm" placeholder="Коментар" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                <i class="bi bi-person-check me-1"></i>Активувати
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
