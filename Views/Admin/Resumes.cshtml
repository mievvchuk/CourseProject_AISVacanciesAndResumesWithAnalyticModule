@model AisVacanciesAndResumes.ViewModels.Admin.AdminResumeIndexViewModel

@{
    ViewData["Title"] = "Резюме";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Модерація резюме</h2>
        <div class="text-secondary">Адміністратор переглядає резюме, схвалює його або відхиляє з поясненням для кандидата. Знайдено: @Model.Items.Count</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Resumes" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="admin-resume-search">Пошук</label>
                <input id="admin-resume-search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Назва, кандидат або категорія" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="admin-resume-status">Статус</label>
                <select id="admin-resume-status" name="Status" class="form-select">
                    <option value="">Усі статуси</option>
                    @foreach (var status in Enum.GetValues<ResumeStatus>())
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status)">@status.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="admin-resume-published">Публікація</label>
                <select id="admin-resume-published" name="IsPublished" class="form-select">
                    <option value="">Усі</option>
                    <option value="true" selected="@(Model.Filter.IsPublished == true)">Опубліковані</option>
                    <option value="false" selected="@(Model.Filter.IsPublished == false)">Приховані</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Знайти
                </button>
                <a asp-action="Resumes" class="btn btn-outline-secondary" title="Очистити">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="card">
        <div class="admin-empty-state">
            <i class="bi bi-file-earmark-person"></i>
            <h2>Резюме немає</h2>
            <p>Опубліковані резюме кандидатів з'являться у цьому розділі.</p>
        </div>
    </div>
}
else
{
    <div class="admin-moderation-list">
        @foreach (var item in Model.Items)
        {
            <article class="card admin-moderation-card">
                <div class="card-body">
                    <div class="admin-moderation-main">
                        <div>
                            <h3 class="h5 mb-2">@item.Title</h3>
                            <div class="admin-meta-grid">
                                <span><i class="bi bi-person me-1"></i>@item.CandidateName</span>
                                <span><i class="bi bi-grid me-1"></i>@item.CategoryName</span>
                                <span><i class="bi bi-calendar me-1"></i>@item.CreatedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="badge text-bg-info">@item.Status.GetDisplayName()</span>
                                @if (item.IsPublished)
                                {
                                    <span class="badge text-bg-success">Опубліковано</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">Приховано</span>
                                }
                            </div>
                        </div>
                        <div class="admin-moderation-actions">
                            <a asp-controller="EmployerCandidates" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>Переглянути
                            </a>
                            @if (item.Status == ResumeStatus.Published && item.IsPublished)
                            {
                                <span class="btn btn-outline-success disabled">
                                    <i class="bi bi-check2-circle me-1"></i>Уже прийняте
                                </span>
                            }
                            else if (item.Status == ResumeStatus.UnderModeration)
                            {
                                <form asp-action="ApproveResume" method="post" class="admin-approve-form">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check2-circle me-1"></i>Прийняти
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                    @if (item.Status == ResumeStatus.UnderModeration)
                    {
                        <form asp-action="RejectResume" method="post" class="admin-reject-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <textarea name="comment" class="form-control" rows="2" required placeholder="Коментар для кандидата: що потрібно виправити"></textarea>
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Відхилити резюме та надіслати коментар кандидату?');">
                                <i class="bi bi-x-circle me-1"></i>Відхилити
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
