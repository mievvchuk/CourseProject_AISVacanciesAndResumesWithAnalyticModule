@model List<AisVacanciesAndResumes.ViewModels.Admin.AdminVacancyListItemViewModel>

@{
    ViewData["Title"] = "Вакансії";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Модерація вакансій</h2>
        <div class="text-secondary">Адміністратор переглядає вакансії, які роботодавці надіслали на модерацію.</div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="admin-empty-state">
            <i class="bi bi-briefcase"></i>
            <h2>Вакансій немає</h2>
            <p>Нові вакансії роботодавців з'являться тут для перегляду та модерації.</p>
        </div>
    </div>
}
else
{
    <div class="admin-moderation-list">
        @foreach (var item in Model)
        {
            var canModerate = item.Status == VacancyStatus.UnderModeration;

            <article class="card admin-moderation-card">
                <div class="card-body">
                    <div class="admin-moderation-main">
                        <div>
                            <h3 class="h5 mb-2">@item.Title</h3>
                            <div class="admin-meta-grid">
                                <span><i class="bi bi-building me-1"></i>@item.CompanyName</span>
                                <span><i class="bi bi-grid me-1"></i>@item.CategoryName</span>
                                <span><i class="bi bi-calendar me-1"></i>@item.PublishedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="badge text-bg-info">@item.Status.GetDisplayName()</span>
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsActive ? "Опублікована" : "Неактивна")
                                </span>
                            </div>
                        </div>
                        <div class="admin-moderation-actions">
                            <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>Переглянути
                            </a>
                            @if (canModerate)
                            {
                                <form asp-action="ApproveVacancy" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check2-circle me-1"></i>Прийняти
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary disabled">
                                    <i class="bi bi-lock me-1"></i>Модерація не потрібна
                                </span>
                            }
                        </div>
                    </div>

                    @if (canModerate)
                    {
                        <form asp-action="RejectVacancy" method="post" class="admin-reject-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <textarea name="comment" class="form-control" rows="2" required placeholder="Коментар для роботодавця: що потрібно виправити"></textarea>
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Відхилити вакансію та надіслати коментар роботодавцю?');">
                                <i class="bi bi-x-circle me-1"></i>Відхилити
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
