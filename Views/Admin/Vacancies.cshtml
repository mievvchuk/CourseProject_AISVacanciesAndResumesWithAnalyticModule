@model AisVacanciesAndResumes.ViewModels.Admin.AdminVacancyIndexViewModel

@{
    ViewData["Title"] = "Вакансії";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h4 mb-1">Модерація вакансій</h2>
        <div class="text-secondary">Адміністратор переглядає вакансії, які роботодавці надіслали на модерацію. Знайдено: @Model.Items.Count</div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Vacancies" method="get" class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label" for="admin-vacancy-search">Пошук</label>
                <input id="admin-vacancy-search" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Назва, компанія або категорія" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="admin-vacancy-status">Статус</label>
                <select id="admin-vacancy-status" name="Status" class="form-select">
                    <option value="">Усі статуси</option>
                    @foreach (var status in Enum.GetValues<VacancyStatus>())
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status)">@status.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="admin-vacancy-active">Активність</label>
                <select id="admin-vacancy-active" name="IsActive" class="form-select">
                    <option value="">Усі</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Активні</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Неактивні</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-fill">
                    <i class="bi bi-search me-1"></i>Знайти
                </button>
                <a asp-action="Vacancies" class="btn btn-outline-secondary" title="Очистити">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="card">
        <div class="admin-empty-state">
            <i class="bi bi-briefcase"></i>
            <h2>Вакансій немає</h2>
            <p>Нові вакансії роботодавців з'являться тут для перегляду та модерації.</p>
        </div>
    </div>
}
else
{
    <div class="admin-moderation-list">
        @foreach (var item in Model.Items)
        {
            var canModerate = item.Status == VacancyStatus.UnderModeration;

            <article class="card admin-moderation-card">
                <div class="card-body">
                    <div class="admin-moderation-main">
                        <div>
                            <h3 class="h5 mb-2">@item.Title</h3>
                            <div class="admin-meta-grid">
                                <span><i class="bi bi-building me-1"></i>@item.CompanyName</span>
                                <span><i class="bi bi-grid me-1"></i>@item.CategoryName</span>
                                <span><i class="bi bi-calendar me-1"></i>@item.PublishedAt.ToString("dd.MM.yyyy")</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                <span class="badge text-bg-info">@item.Status.GetDisplayName()</span>
                                <span class="badge @(item.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                    @(item.IsActive ? "Опублікована" : "Неактивна")
                                </span>
                            </div>
                        </div>
                        <div class="admin-moderation-actions">
                            <a asp-controller="Vacancies" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">
                                <i class="bi bi-eye me-1"></i>Переглянути
                            </a>
                            @if (canModerate)
                            {
                                <form asp-action="ApproveVacancy" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-check2-circle me-1"></i>Прийняти
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="btn btn-outline-secondary disabled">
                                    <i class="bi bi-lock me-1"></i>Модерація не потрібна
                                </span>
                            }
                        </div>
                    </div>

                    @if (canModerate)
                    {
                        <form asp-action="RejectVacancy" method="post" class="admin-reject-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <textarea name="comment" class="form-control" rows="2" required placeholder="Коментар для роботодавця: що потрібно виправити"></textarea>
                            <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Відхилити вакансію та надіслати коментар роботодавцю?');">
                                <i class="bi bi-x-circle me-1"></i>Відхилити
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}
