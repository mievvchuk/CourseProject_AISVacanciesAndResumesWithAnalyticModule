@model ResumeDetailsViewModel

@{
    ViewData["Title"] = "Деталі резюме";
    var candidateName = string.IsNullOrWhiteSpace(Model.FullName) ? "Кандидат" : Model.FullName;
    var desiredPosition = string.IsNullOrWhiteSpace(Model.DesiredPosition) ? Model.Title : Model.DesiredPosition;
    var city = string.IsNullOrWhiteSpace(Model.City) ? "Місто не вказано" : Model.City;
    var salary = Model.DesiredSalary.HasValue ? $"{Model.DesiredSalary:N0} грн" : "Зарплату не вказано";
    var experienceYears = Model.ExperienceYears == 1
        ? "1 рік"
        : Model.ExperienceYears is >= 2 and <= 4
            ? $"{Model.ExperienceYears} роки"
            : $"{Model.ExperienceYears} років";
}

@functions {
    private static string ShowText(string? value, string fallback = "Не вказано")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }
}

<section class="employer-candidate-details-page">
    <a asp-action="Search" class="vacancy-back-link">
        <i class="ti ti-arrow-left"></i>
        Назад до пошуку кандидатів
    </a>

    <div class="candidate-detail-layout">
        <div class="candidate-detail-main">
            <section class="candidate-detail-hero">
                <div class="candidate-detail-avatar" aria-hidden="true">
                    @candidateName.Trim()[0]
                </div>
                <div class="candidate-detail-heading">
                    <div class="candidate-detail-eyebrow">@Model.CategoryName</div>
                    <h1>@desiredPosition</h1>
                    <div class="candidate-detail-name">
                        <i class="ti ti-user"></i>
                        <span>@candidateName</span>
                    </div>
                </div>
            </section>

            <section class="candidate-detail-metrics">
                <div class="candidate-detail-metric">
                    <i class="ti ti-map-pin"></i>
                    <span>Локація</span>
                    <strong>@city</strong>
                </div>
                <div class="candidate-detail-metric">
                    <i class="ti ti-briefcase"></i>
                    <span>Зайнятість</span>
                    <strong>@Model.EmploymentType.GetDisplayName()</strong>
                </div>
                <div class="candidate-detail-metric">
                    <i class="ti ti-chart-bar"></i>
                    <span>Досвід</span>
                    <strong>@Model.ExperienceLevel.GetDisplayName() · @experienceYears</strong>
                </div>
                <div class="candidate-detail-metric">
                    <i class="ti ti-currency-hryvnia"></i>
                    <span>Очікування</span>
                    <strong>@salary</strong>
                </div>
            </section>

            <section class="candidate-detail-section">
                <h2>Короткий опис</h2>
                <p>@ShowText(Model.Summary, "Кандидат поки не додав короткий опис.")</p>
            </section>

            <section class="candidate-detail-section">
                <h2>Досвід</h2>
                <p>@ShowText(Model.Experience, "Досвід не описано.")</p>
            </section>

            <section class="candidate-detail-section">
                <h2>Освіта</h2>
                <p>@ShowText(Model.Education, "Освіту не вказано.")</p>
            </section>

            <section class="candidate-detail-section">
                <div class="candidate-detail-section-head">
                    <h2>Навички</h2>
                    @if (!string.IsNullOrWhiteSpace(Model.SkillsDescription))
                    {
                        <span>@Model.SkillsDescription</span>
                    }
                </div>

                @if (Model.SkillNames.Any())
                {
                    <div class="candidate-detail-skills">
                        @foreach (var skill in Model.SkillNames)
                        {
                            <span class="badge bg-muted-lt text-secondary border">@skill</span>
                        }
                    </div>
                }
                else if (string.IsNullOrWhiteSpace(Model.SkillsDescription))
                {
                    <p class="text-secondary mb-0">Навички не вказано.</p>
                }
            </section>
        </div>

        <aside class="candidate-detail-sidebar">
            <section class="candidate-action-panel">
                <h2>Дії з кандидатом</h2>
                <p>Збережіть контекст перегляду або одразу напишіть кандидату щодо релевантної вакансії.</p>

                @if (!string.IsNullOrWhiteSpace(Model.CandidateUserId))
                {
                    <a asp-controller="Messages"
                       asp-action="Create"
                       asp-route-receiverId="@Model.CandidateUserId"
                       class="btn btn-primary w-100">
                        <i class="ti ti-message-circle me-1"></i>
                        Написати кандидату
                    </a>
                }

                <a asp-action="Search" class="btn btn-outline-secondary w-100">
                    <i class="ti ti-search me-1"></i>
                    До пошуку кандидатів
                </a>
            </section>

            <section class="candidate-side-card">
                <h2>Профіль резюме</h2>
                <dl>
                    <dt>Назва резюме</dt>
                    <dd>@ShowText(Model.Title)</dd>
                    <dt>Освіта</dt>
                    <dd>@Model.EducationLevel.GetDisplayName()</dd>
                    <dt>Статус</dt>
                    <dd>@Model.Status.GetDisplayName()</dd>
                </dl>
            </section>

            <section class="candidate-side-card">
                <h2>Файл резюме</h2>
                @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                {
                    <a href="@Model.FilePath" target="_blank" class="candidate-file-link">
                        <i class="ti ti-file-text"></i>
                        <span>@ShowText(Model.OriginalFileName, "Відкрити файл")</span>
                    </a>
                }
                else
                {
                    <div class="candidate-file-empty">
                        <i class="ti ti-file-off"></i>
                        <span>Файл не завантажено</span>
                    </div>
                }
            </section>
        </aside>
    </div>
</section>
