@using AisVacanciesAndResumes.Services
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject INotificationService NotificationService
@inject IMessageService MessageService
@inject UserManager<AisVacanciesAndResumes.Models.User> UserManager
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - АІС вакансій та резюме</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.34.1/dist/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AisVacanciesAndResumes.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var unreadNotificationCount = 0;
        var unreadMessageCount = 0;
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        var isAuthenticated = User.Identity?.IsAuthenticated == true;

        if (isAuthenticated && !string.IsNullOrWhiteSpace(userId))
        {
            unreadNotificationCount = await NotificationService.GetUnreadCountAsync(userId);
            unreadMessageCount = await MessageService.GetUnreadCountAsync(userId);
        }

        var hour = DateTime.Now.Hour;
        var greeting = hour < 12 ? "Доброго ранку" : hour < 18 ? "Добрий день" : "Добрий вечір";
        var currentUser = isAuthenticated ? await UserManager.GetUserAsync(User) : null;
        var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName)
            ? currentUser.FullName
            : "користувачу";
        var profileController = User.IsInRole("Employer") ? "EmployerProfiles" : User.IsInRole("Admin") ? "Admin" : "CandidateProfiles";
        var profileAction = User.IsInRole("Admin") ? "Dashboard" : "Edit";
    }

    <a class="visually-hidden-focusable" href="#main-content">Перейти до основного вмісту</a>
    <a class="visually-hidden-focusable" href="#main-navigation">Перейти до навігації</a>

    <div class="page">
        <header class="navbar navbar-expand-md d-print-none app-header">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Перемкнути навігацію">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <h1 class="navbar-brand navbar-brand-autodark pe-0">
                    <a asp-controller="Home" asp-action="Index" class="text-reset text-decoration-none">
                        <span class="brand-mark me-2"><i class="ti ti-briefcase"></i></span>
                        АІС вакансій
                    </a>
                </h1>

                <div class="navbar-nav flex-row order-md-last align-items-center gap-2">
                    @if (isAuthenticated)
                    {
                        <div class="nav-item text-secondary small d-none d-lg-block">
                            @greeting, @displayName
                        </div>

                        <a class="btn btn-icon btn-ghost-secondary position-relative" asp-controller="Messages" asp-action="Inbox" title="Повідомлення">
                            <i class="ti ti-mail fs-2"></i>
                            @if (unreadMessageCount > 0)
                            {
                                <span class="badge bg-red text-white badge-notification">@unreadMessageCount</span>
                            }
                        </a>

                        <a class="btn btn-icon btn-ghost-secondary position-relative" asp-controller="Notifications" asp-action="Index" title="Сповіщення">
                            <i class="ti ti-bell fs-2"></i>
                            @if (unreadNotificationCount > 0)
                            {
                                <span class="badge bg-red text-white badge-notification">@unreadNotificationCount</span>
                            }
                        </a>

                        <a class="btn btn-icon btn-primary" asp-controller="@profileController" asp-action="@profileAction" title="Мій профіль">
                            <i class="ti ti-user-circle fs-2"></i>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="nav-item">
                            <button type="submit" class="btn btn-outline-primary">
                                <i class="ti ti-logout me-1"></i>Вийти
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">
                            <i class="ti ti-login-2 me-1"></i>Увійти
                        </a>
                        <a class="btn btn-primary" asp-controller="Account" asp-action="Register">
                            <i class="ti ti-user-plus me-1"></i>Реєстрація
                        </a>
                    }
                </div>
            </div>
        </header>

        <div class="navbar-expand-md">
            <div class="collapse navbar-collapse" id="main-navigation">
                <div class="navbar navbar-light">
                    <div class="container-xl app-nav-container">
                        <ul class="navbar-nav app-main-nav">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-home"></i></span>
                                    <span class="nav-link-title">Головна</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Vacancies" asp-action="Index">
                                    <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-search"></i></span>
                                    <span class="nav-link-title">Вакансії</span>
                                </a>
                            </li>

                            @if (isAuthenticated && User.IsInRole("Candidate"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Resumes" asp-action="Index"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-file-text"></i></span><span class="nav-link-title">Мої резюме</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="MyApplications"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-send"></i></span><span class="nav-link-title">Мої заявки</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="SavedSearches" asp-action="Index"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-bookmark"></i></span><span class="nav-link-title">Збережені пошуки</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Portfolio" asp-action="Index"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-layout-grid"></i></span><span class="nav-link-title">Портфоліо</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Recommendations" asp-action="Index"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-stars"></i></span><span class="nav-link-title">Рекомендації</span></a></li>
                            }

                            @if (isAuthenticated && User.IsInRole("Employer"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="My"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-briefcase"></i></span><span class="nav-link-title">Мої вакансії</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Vacancies" asp-action="Create"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-circle-plus"></i></span><span class="nav-link-title">Створити вакансію</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Applications" asp-action="EmployerApplications"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-inbox"></i></span><span class="nav-link-title">Усі заявки</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="EmployerCandidates" asp-action="Search"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-users-group"></i></span><span class="nav-link-title">Кандидати</span></a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Analytics" asp-action="Index"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-chart-bar"></i></span><span class="nav-link-title">Аналітика</span></a></li>
                            }

                            @if (isAuthenticated && User.IsInRole("Admin"))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-shield-lock"></i></span><span class="nav-link-title">Адмінка</span></a></li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <main class="page-wrapper" id="main-content">
            <div class="page-body">
                <div class="container-xl">
                    @if (TempData["StatusMessage"] is string statusMessage)
                    {
                        <div class="alert alert-success" role="alert">@statusMessage</div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger" role="alert">@errorMessage</div>
                    }

                    @if (unreadMessageCount > 0)
                    {
                        <div class="alert alert-info d-flex align-items-center" role="alert">
                            <i class="ti ti-mail me-2"></i>
                            У вас є нові повідомлення:
                            <a asp-controller="Messages" asp-action="Inbox" class="alert-link ms-1">переглянути</a>.
                        </div>
                    }

                    @RenderBody()
                </div>
            </div>

            <footer class="footer footer-transparent d-print-none mt-auto">
                <div class="container-xl">
                    <div class="row text-center align-items-center flex-row-reverse">
                        <div class="col-lg-auto ms-lg-auto">
                            <ul class="list-inline list-inline-dots mb-0">
                                <li class="list-inline-item"><a asp-controller="Vacancies" asp-action="Index" class="link-secondary">Вакансії</a></li>
                                <li class="list-inline-item"><a asp-controller="Home" asp-action="Privacy" class="link-secondary">Політика</a></li>
                            </ul>
                        </div>
                        <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                            <span class="text-secondary">&copy; @DateTime.Now.Year АІС вакансій та резюме. Навчальний проєкт.</span>
                        </div>
                    </div>
                </div>
            </footer>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.4.0/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
