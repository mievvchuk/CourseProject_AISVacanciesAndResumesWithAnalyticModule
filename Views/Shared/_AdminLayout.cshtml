@{
    var title = ViewData["Title"] as string ?? "Адміністративна панель";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isAdmin = string.Equals(controller, "Admin", StringComparison.OrdinalIgnoreCase);
    Func<string, string> active = item => isAdmin && string.Equals(action, item, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - АІС вакансій</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/adminlte/css/adminlte.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <a class="visually-hidden-focusable" href="#main-content">Перейти до основного вмісту</a>
    <a class="visually-hidden-focusable" href="#admin-navigation">Перейти до навігації</a>

    <div class="app-wrapper">
        <nav class="app-header navbar navbar-expand bg-body">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button" aria-label="Перемкнути меню">
                            <i class="bi bi-list"></i>
                        </a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Admin" asp-action="Dashboard" class="nav-link">Адмінка</a>
                    </li>
                    <li class="nav-item d-none d-md-block">
                        <a asp-controller="Home" asp-action="Index" class="nav-link">На сайт</a>
                    </li>
                </ul>
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    <li class="nav-item text-secondary small d-none d-md-block">@User.Identity?.Name</li>
                    <li class="nav-item">
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-right me-1"></i> Вийти
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </nav>

        <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark" id="admin-navigation">
            <div class="sidebar-brand">
                <a asp-controller="Admin" asp-action="Dashboard" class="brand-link">
                    <img src="~/lib/adminlte/img/AdminLTELogo.png" alt="АІС Admin" class="brand-image opacity-75 shadow" />
                    <span class="brand-text fw-light">АІС Admin</span>
                </a>
            </div>
            <div class="sidebar-wrapper">
                <nav class="mt-2">
                    <ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu">
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Dashboard" class="nav-link @active("Dashboard")">
                                <i class="nav-icon bi bi-speedometer2"></i><p>Панель</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Users" class="nav-link @active("Users")">
                                <i class="nav-icon bi bi-people"></i><p>Користувачі</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Vacancies" class="nav-link @active("Vacancies")">
                                <i class="nav-icon bi bi-briefcase"></i><p>Вакансії</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="Resumes" class="nav-link @active("Resumes")">
                                <i class="nav-icon bi bi-file-earmark-person"></i><p>Резюме</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Admin" asp-action="ModerationLog" class="nav-link @active("ModerationLog")">
                                <i class="nav-icon bi bi-journal-check"></i><p>Журнал модерації</p>
                            </a>
                        </li>
                        <li class="nav-header">Звіти</li>
                        <li class="nav-item">
                            <a asp-controller="Export" asp-action="Analytics" class="nav-link">
                                <i class="nav-icon bi bi-filetype-csv"></i><p>Експорт CSV</p>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Export" asp-action="AnalyticsPdf" class="nav-link">
                                <i class="nav-icon bi bi-filetype-pdf"></i><p>Експорт PDF</p>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <main class="app-main" id="main-content">
            <div class="app-content-header">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-sm-6"><h1 class="mb-0">@title</h1></div>
                        <div class="col-sm-6">
                            <ol class="breadcrumb float-sm-end">
                                <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Адмінка</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@title</li>
                            </ol>
                        </div>
                    </div>
                </div>
            </div>
            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["StatusMessage"] is string message)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@message
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] is string errorMessage)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@errorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрити"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
        </main>

        <footer class="app-footer">
            <div class="float-end d-none d-sm-inline">Адміністративна частина</div>
            <strong>&copy; 2026 АІС вакансій та резюме.</strong>
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/adminlte/js/adminlte.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
