@model AisVacanciesAndResumes.ViewModels.Portfolio.PortfolioItemFormViewModel

@{
    ViewData["Title"] = "Редагування проєкту";

    bool HasValue(string? value)
    {
        return !string.IsNullOrWhiteSpace(value) && value.Trim() != "-";
    }

    string NormalizeExternalUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return string.Empty;
        }

        var value = url.Trim();

        if (value.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            value.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return value;
        }

        return $"https://{value}";
    }

    var projectUrl = NormalizeExternalUrl(Model.Url);
    var imageUrl = NormalizeExternalUrl(Model.ImagePath);
}

<section class="portfolio-form-page">
    <div class="portfolio-form-card card shadow-sm border-0">
        <div class="portfolio-form-cover"></div>

        <div class="card-body">
            <div class="portfolio-form-head">
                <div>
                    <div class="portfolio-form-eyebrow">Портфоліо</div>
                    <h1>Редагування проєкту</h1>
                    <p>Оновіть опис, посилання та зображення проєкту.</p>
                </div>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ti ti-arrow-left me-1"></i>
                    Назад
                </a>
            </div>

            <form asp-action="Edit" method="post" class="portfolio-form">
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="portfolio-form-grid">
                    <div class="portfolio-form-main">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Назва проєкту</label>
                            <input asp-for="Title" class="form-control" placeholder="Наприклад: CRM-система для компанії" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Опис</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Коротко опишіть, що було зроблено, які технології використовувались і який результат отримано"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Url" class="form-label">Посилання на проєкт</label>
                            <input asp-for="Url" class="form-control" placeholder="https://example.com/project" />
                            <span asp-validation-for="Url" class="text-danger"></span>
                            <div class="form-hint">
                                Можна вставити посилання на сайт, GitHub, Behance або інший ресурс.
                            </div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="ImagePath" class="form-label">Посилання на зображення</label>
                            <input asp-for="ImagePath" class="form-control" placeholder="https://example.com/image.jpg" />
                            <span asp-validation-for="ImagePath" class="text-danger"></span>
                            <div class="form-hint">
                                Для прев’ю потрібне пряме посилання на файл картинки: .jpg, .png або .webp.
                                Посилання на сторінку сайту, наприклад Pexels-сторінку, як картинка не відкриється.
                            </div>
                        </div>
                    </div>

                    <aside class="portfolio-form-preview">
                        <h2>Попередній перегляд</h2>

                        <article class="portfolio-preview-card">
                            @if (HasValue(Model.ImagePath))
                            {
                                <div class="portfolio-preview-image-wrap">
                                    <img src="@imageUrl"
                                         alt="@Model.Title"
                                         class="portfolio-preview-image"
                                         onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                                    <div class="portfolio-preview-image-fallback">
                                        <i class="ti ti-photo-off"></i>
                                        <span>Зображення не відкривається</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="portfolio-preview-image-fallback portfolio-preview-image-fallback-visible">
                                    <i class="ti ti-photo"></i>
                                    <span>Зображення не додано</span>
                                </div>
                            }

                            <div class="portfolio-preview-body">
                                <h3>@(!string.IsNullOrWhiteSpace(Model.Title) ? Model.Title : "Назва проєкту")</h3>
                                <p>@(!string.IsNullOrWhiteSpace(Model.Description) ? Model.Description : "Опис проєкту буде показано тут.")</p>

                                @if (HasValue(Model.Url))
                                {
                                    <a href="@projectUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="ti ti-external-link me-1"></i>
                                        Відкрити проєкт
                                    </a>
                                }
                            </div>
                        </article>
                    </aside>
                </div>

                <div class="portfolio-form-actions">
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-1"></i>
                        Зберегти зміни
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Скасувати
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}