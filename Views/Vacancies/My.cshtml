@model VacancyIndexViewModel

@{
    ViewData["Title"] = "Мої вакансії";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h2 class="h3 mb-1">Мої вакансії</h2>
        <div class="text-secondary">Керуйте власними вакансіями окремо від загального каталогу.</div>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="ti ti-circle-plus me-1"></i>Створити вакансію</a>
</div>

@if (!Model.Items.Any())
{
    <div class="card shadow-sm border-0">
        <div class="card-body text-center py-5">
            <div class="feature-icon bg-primary-lt text-primary mx-auto mb-3"><i class="ti ti-briefcase-off"></i></div>
            <h3 class="h4 mb-2">Ви ще не створили вакансій</h3>
            <p class="text-secondary mb-0">Створіть першу вакансію, і вона потрапить на модерацію адміністратору.</p>
        </div>
    </div>
}
else
{
    <div class="vacancy-list">
        @foreach (var item in Model.Items)
        {
            <article class="card vacancy-card vacancy-list-card shadow-sm border-0">
                <div class="card-body">
                    <div class="vacancy-row">
                        <div class="vacancy-main">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <h3 class="h4 mb-0">@item.Title</h3>
                                <span class="badge bg-primary-lt text-primary">@item.Status.GetDisplayName()</span>
                            </div>
                            <div class="text-secondary mb-3">@item.CategoryName · @item.City</div>
                            <div class="vacancy-meta">
                                <span><i class="ti ti-cash"></i>@item.SalaryFrom - @item.SalaryTo грн</span>
                                <span><i class="ti ti-briefcase"></i>@item.EmploymentType.GetDisplayName()</span>
                                <span><i class="ti ti-chart-bar"></i>@item.ExperienceLevel.GetDisplayName()</span>
                            </div>
                        </div>
                        <div class="vacancy-actions">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">Переглянути</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary">Редагувати</a>
                            <a asp-controller="Applications" asp-action="VacancyApplications" asp-route-vacancyId="@item.Id" class="btn btn-outline-secondary">Заявки</a>
                            @if (item.Status == VacancyStatus.Published)
                            {
                                <form asp-action="Close" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-warning w-100" onclick="return confirm('Закрити цю вакансію?');">Закрити</button>
                                </form>
                            }
                            @if (item.Status != VacancyStatus.Archived)
                            {
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                    <button type="submit" class="btn btn-outline-danger w-100" onclick="return confirm('Архівувати цю вакансію?');">Архівувати</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
