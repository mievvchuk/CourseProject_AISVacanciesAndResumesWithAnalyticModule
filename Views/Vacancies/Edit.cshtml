@model VacancyFormViewModel

@{
    ViewData["Title"] = "Редагування вакансії";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">Редагування вакансії</h2>
                    <div class="text-secondary">Після редагування вакансія повторно переходить на модерацію.</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <input asp-for="EmployerProfileId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="alert alert-warning border">
                        <strong>Після збереження:</strong> вакансія не буде активною, доки адміністратор не схвалить зміни.
                    </div>
                    <div class="alert alert-light border">
                        <strong>Місто компанії:</strong> @Model.City
                    </div>
                    <partial name="_VacancyFormFields" model="Model" />
                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Зберегти зміни</button>
                        <a asp-action="My" class="btn btn-outline-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
