@model VacancyFormViewModel

@{
    ViewData["Title"] = "Створення вакансії";
}

<div class="row justify-content-center vacancy-form-page">
    <div class="col-lg-9">
        <div class="card shadow-sm border-0">
            <div class="card-header">
                <div>
                    <h2 class="card-title mb-1">Створення вакансії</h2>
                    <div class="text-secondary">Заповніть вакансію. Після збереження вона потрапить на модерацію.</div>
                </div>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="alert alert-info border">
                        <strong>Статус після збереження:</strong> на модерації. Активувати вакансію може адміністратор.
                    </div>
                    <div class="alert alert-light border">
                        <strong>Місто компанії:</strong> @Model.City
                    </div>
                    <partial name="_VacancyFormFields" model="Model" />
                    <div class="vacancy-form-actions mt-4">
                        <button type="submit" class="btn btn-primary"><i class="ti ti-device-floppy me-1"></i>Зберегти</button>
                        <a asp-action="My" class="btn btn-outline-secondary">Назад</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
