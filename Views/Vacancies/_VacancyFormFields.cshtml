@model VacancyFormViewModel

<div class="row g-3 vacancy-form-grid">
    <div class="col-md-8">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label class="form-label" asp-for="CategoryId">Категорія зі списку</label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
            <option value="0">Оберіть категорію</option>
        </select>
        <div class="form-hint">Або введіть свою категорію нижче.</div>
    </div>
    <div class="col-12">
        <label asp-for="CategoryName" class="form-label">Своя категорія</label>
        <input asp-for="CategoryName" class="form-control" placeholder="Наприклад: Медицина" autocomplete="off" />
        <span asp-validation-for="CategoryName" class="text-danger"></span>
        <div class="form-hint">Заповнюйте це поле тільки якщо потрібної категорії немає у списку.</div>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Requirements" class="form-label"></label>
        <textarea asp-for="Requirements" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Requirements" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SalaryFrom" class="form-label"></label>
        <input asp-for="SalaryFrom" class="form-control" />
        <span asp-validation-for="SalaryFrom" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="SalaryTo" class="form-label"></label>
        <input asp-for="SalaryTo" class="form-control" />
        <span asp-validation-for="SalaryTo" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="EmploymentType" class="form-label"></label>
        <select asp-for="EmploymentType" asp-items="Html.GetEnumSelectList<EmploymentType>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="ExperienceLevel" class="form-label"></label>
        <select asp-for="ExperienceLevel" asp-items="Html.GetEnumSelectList<ExperienceLevel>()" class="form-select"></select>
    </div>
    <div class="col-md-4">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="Наприклад: Київ або віддалено" />
    </div>
    <div class="col-md-4">
        <label asp-for="ClosingDate" class="form-label"></label>
        <input asp-for="ClosingDate" class="form-control" type="date" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Готові навички</label>
        <div class="vacancy-skill-picker">
            @if (Model.SkillOptions.Any())
            {
                @foreach (var skill in Model.SkillOptions)
                {
                    var isChecked = int.TryParse(skill.Value, out var skillId) && Model.SelectedSkillIds.Contains(skillId);
                    <label class="form-check vacancy-skill-option">
                        <input class="form-check-input" type="checkbox" name="SelectedSkillIds" value="@skill.Value" checked="@isChecked" />
                        <span class="form-check-label">@skill.Text</span>
                    </label>
                }
            }
            else
            {
                <div class="text-secondary">Готових навичок ще немає.</div>
            }
        </div>
        <span asp-validation-for="SelectedSkillIds" class="text-danger"></span>
        <div class="form-hint">Необов’язково. Можна нічого не обирати й просто вписати свої навички.</div>
    </div>
    <div class="col-md-6">
        <label asp-for="SkillsText" class="form-label"></label>
        <textarea asp-for="SkillsText" class="form-control" rows="7" placeholder="Наприклад: C#, PostgreSQL, комунікація"></textarea>
        <span asp-validation-for="SkillsText" class="text-danger"></span>
        <div class="form-hint">Якщо навички немає у списку, впишіть її тут через кому або з нового рядка.</div>
    </div>
</div>
