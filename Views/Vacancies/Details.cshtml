@model VacancyDetailsViewModel

@{
    var location = !string.IsNullOrWhiteSpace(Model.Location) ? Model.Location : Model.City;
    var seoLocation = !string.IsNullOrWhiteSpace(location) ? location : "Україна";
    var seoTitle = $"{Model.Title} — {Model.CompanyName}, {seoLocation}";
    var seoDescriptionSource = !string.IsNullOrWhiteSpace(Model.Description)
        ? Model.Description
        : $"Вакансія {Model.Title} у компанії {Model.CompanyName}, {seoLocation}.";
    var seoDescription = seoDescriptionSource.Length > 155
        ? seoDescriptionSource[..152] + "..."
        : seoDescriptionSource;
    var isAdmin = User.IsInRole("Admin");
    var backController = isAdmin ? "Admin" : "Vacancies";
    var backAction = isAdmin ? "Vacancies" : "Index";
    var backText = isAdmin ? "Повернутися до модерації вакансій" : "Повернутися до списку вакансій";
    ViewData["Title"] = seoTitle;
    ViewData["MetaDescription"] = seoDescription;
    ViewData["MetaKeywords"] = $"{Model.Title}, {Model.CompanyName}, вакансія, робота, {seoLocation}";
    if (Model.IsActive && Model.Status == VacancyStatus.Published)
    {
        ViewData["CanonicalPath"] = $"/Vacancies/Details/{Model.Id}";
    }
}

@functions {
    private static string FormatSalary(decimal from, decimal to)
    {
        if (from <= 0 && to <= 0)
        {
            return "Зарплату не вказано";
        }

        if (from > 0 && to > 0)
        {
            return $"{from:N0} - {to:N0} грн";
        }

        return from > 0 ? $"від {from:N0} грн" : $"до {to:N0} грн";
    }
}

<section class="vacancy-details-page vacancy-details-page-wide">
    <a asp-controller="@backController" asp-action="@backAction" class="vacancy-back-link">
        <i class="ti ti-arrow-left"></i>
        @backText
    </a>

    <section class="card vacancy-overview-card shadow-sm border-0">
        <div class="card-body">
            <div class="vacancy-overview-top">
                <div>
                    <h1 class="vacancy-details-title">@Model.Title</h1>
                    <div class="vacancy-overview-company">
                        <i class="ti ti-building"></i>
                        <span>@Model.CompanyName</span>
                    </div>
                </div>

                @if (Model.CanManage)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="ti ti-edit me-1"></i>
                        Редагувати
                    </a>
                }
            </div>

            <div class="vacancy-overview-grid">
                <div class="vacancy-overview-item">
                    <i class="ti ti-map-pin"></i>
                    <span>@location</span>
                </div>
                <div class="vacancy-overview-item">
                    <i class="ti ti-currency-hryvnia"></i>
                    <span>@FormatSalary(Model.SalaryFrom, Model.SalaryTo)</span>
                </div>
                <div class="vacancy-overview-item">
                    <i class="ti ti-briefcase"></i>
                    <span>@Model.EmploymentType.GetDisplayName()</span>
                </div>
                <div class="vacancy-overview-item">
                    <i class="ti ti-calendar-stats"></i>
                    <span>Досвід: @Model.ExperienceLevel.GetDisplayName()</span>
                </div>
            </div>

            <div class="vacancy-overview-footer">
                <span class="badge bg-green-lt text-green">@Model.Status.GetDisplayName()</span>
                <span class="text-secondary">Опубліковано: @Model.PublishedAt.ToKyivString("dd.MM.yyyy HH:mm")</span>
                @if (Model.ClosingDate.HasValue)
                {
                    <span class="text-secondary">Актуальна до: @Model.ClosingDate.Value.ToString("dd.MM.yyyy")</span>
                }
            </div>
        </div>
    </section>

    @if (isAdmin)
    {
        var canModerate = Model.Status == VacancyStatus.UnderModeration;

        <section class="card vacancy-admin-panel shadow-sm border-0">
            <div class="card-body">
                <div class="vacancy-admin-panel-head">
                    <div>
                        <span class="vacancy-admin-eyebrow"><i class="ti ti-shield-check"></i> Рішення модератора</span>
                        <h2>Перевірка вакансії</h2>
                        <p class="text-secondary mb-0">
                            Перегляньте опис, вимоги та навички. Якщо все коректно, опублікуйте вакансію; якщо ні — залиште коментар роботодавцю.
                        </p>
                    </div>
                    <span class="badge @(canModerate ? "bg-yellow-lt text-yellow" : "bg-green-lt text-green")">
                        @Model.Status.GetDisplayName()
                    </span>
                </div>

                @if (canModerate)
                {
                    <div class="vacancy-admin-actions">
                        <form asp-controller="Admin" asp-action="ApproveVacancy" method="post">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <button type="submit" class="btn btn-success">
                                <i class="ti ti-check me-1"></i>
                                Підтвердити
                            </button>
                        </form>

                        <form asp-controller="Admin" asp-action="RejectVacancy" method="post" class="vacancy-admin-reject-form"
                              data-confirm
                              data-confirm-title="Відхилити вакансію?"
                              data-confirm-message="Коментар буде надіслано роботодавцю, а вакансію буде позначено як відхилену."
                              data-confirm-submit="Відхилити">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <label class="form-label" for="moderation-comment">Коментар для роботодавця</label>
                            <textarea id="moderation-comment" name="comment" class="form-control" rows="3" required placeholder="Наприклад: уточніть вимоги або додайте більше деталей про умови роботи"></textarea>
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="ti ti-x me-1"></i>
                                Відхилити
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="vacancy-admin-locked">
                        <i class="ti ti-lock"></i>
                        <span>Для цієї вакансії модераційне рішення вже прийнято.</span>
                    </div>
                }
            </div>
        </section>
    }

    <section class="card vacancy-section shadow-sm border-0">
        <div class="card-body">
            <h2>Опис вакансії</h2>
            <p>@Model.Description</p>
        </div>
    </section>

    <section class="card vacancy-section shadow-sm border-0">
        <div class="card-body">
            <h2>Вимоги</h2>
            <p>@Model.Requirements</p>
        </div>
    </section>

    <section class="card vacancy-section shadow-sm border-0">
        <div class="card-body">
            <h2>Навички</h2>
            @if (Model.SkillNames.Count == 0)
            {
                <p class="text-secondary mb-0">Навички не вказано.</p>
            }
            else
            {
                <div class="vacancy-details-skills">
                    @foreach (var skill in Model.SkillNames)
                    {
                        <span class="badge bg-muted-lt text-secondary border">@skill</span>
                    }
                </div>
            }
        </div>
    </section>

    @if (!isAdmin)
    {
        <section id="apply" class="card vacancy-section vacancy-apply-card shadow-sm border-0">
            <div class="card-body">
                <div class="vacancy-apply-card-head">
                    <div>
                        <h2>Подати заявку</h2>
                        <p class="text-secondary mb-0">Оберіть резюме і, за бажанням, додайте короткий супровідний лист.</p>
                    </div>
                </div>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <p class="text-secondary mb-0">Увійдіть як кандидат, щоб подати заявку на вакансію.</p>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Увійти</a>
                    </div>
                }
                else if (User.IsInRole("Candidate"))
                {
                    @if (Model.HasApplied)
                    {
                        <div class="alert alert-info mb-0">Ви вже подали заявку на цю вакансію.</div>
                    }
                    else if (Model.ResumeOptions.Count == 0 && Model.HasAnyResume)
                    {
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <p class="text-secondary mb-0">
                                У вас вже є резюме, але воно недоступне для подання заявки. Опублікуйте його або дочекайтеся схвалення адміністратором.
                            </p>
                            <a asp-controller="Resumes" asp-action="Index" class="btn btn-outline-primary">
                                <i class="ti ti-file-check me-1"></i>
                                Перевірити резюме
                            </a>
                        </div>
                    }
                    else if (Model.ResumeOptions.Count == 0)
                    {
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <p class="text-secondary mb-0">
                                Спочатку створіть резюме, щоб роботодавець міг переглянути ваш досвід.
                            </p>
                            <a asp-controller="Resumes" asp-action="Create" class="btn btn-primary">
                                <i class="ti ti-file-plus me-1"></i>
                                Створити резюме
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-secondary mb-0">Подача заявки доступна для кандидатів.</p>
                }
            </div>
        </section>
    }
</section>
