@model AisVacanciesAndResumes.ViewModels.Notifications.NotificationDetailsViewModel

@{
    ViewData["Title"] = "Деталі сповіщення";
}

<div class="content-center-page content-center-page-md">
    <div class="w-100">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="mb-4">
                    <div>
                        <h2 class="h4 mb-1">@Model.Title</h2>
                        <div class="text-muted">@Model.CreatedAt.ToKyivString()</div>
                    </div>
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Статус</dt>
                    <dd class="col-sm-9">@(Model.IsRead ? "Прочитано" : "Непрочитано")</dd>

                    <dt class="col-sm-3">Зміст</dt>
                    <dd class="col-sm-9" style="white-space: pre-line;">@Model.Content</dd>
                </dl>

                <a asp-action="Index" class="btn btn-outline-secondary">Назад</a>
            </div>
        </div>
    </div>
</div>
