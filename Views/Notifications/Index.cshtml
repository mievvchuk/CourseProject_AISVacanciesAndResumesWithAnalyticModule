@model List<AisVacanciesAndResumes.ViewModels.Notifications.NotificationListItemViewModel>

@{
    ViewData["Title"] = "Сповіщення";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 mb-0">Сповіщення</h2>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Сповіщень немає.</div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Заголовок</th>
                        <th>Тип</th>
                        <th>Статус</th>
                        <th>Створено</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsRead ? string.Empty : "table-warning")">
                            <td>@item.Title</td>
                            <td>@item.Type.GetDisplayName()</td>
                            <td>@(item.IsRead ? "Прочитано" : "Непрочитано")</td>
                            <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Відкрити</a>
                                @if (!item.IsRead)
                                {
                                    <form asp-action="MarkAsRead" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Позначити як прочитане</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
