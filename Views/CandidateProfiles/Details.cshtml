@model CandidateProfileDetailsViewModel

@{
    ViewData["Title"] = "Профіль кандидата";

    string Show(string? value, string fallback = "Не вказано")
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    var salary = Model.DesiredSalary.HasValue
        ? $"{Model.DesiredSalary.Value:N0} грн"
        : "Не вказано";

    var experienceYears = Model.ExperienceYears == 1
        ? "1 рік"
        : Model.ExperienceYears is >= 2 and <= 4
            ? $"{Model.ExperienceYears} роки"
            : $"{Model.ExperienceYears} років";
}

<section class="profile-show-page">
    <div class="profile-show-card card shadow-sm border-0">
        <div class="profile-show-cover profile-show-cover-candidate"></div>

        <div class="card-body">
            <div class="profile-show-head">
                <div class="profile-show-identity">
                    <div class="profile-show-avatar-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                        {
                            <img src="@Model.PhotoPath"
                                 alt="@Model.FullName"
                                 class="profile-show-avatar-image"
                                 style="width: 108px; height: 108px; min-width: 108px; max-width: 108px; min-height: 108px; max-height: 108px; object-fit: cover; border-radius: 10px; display: block;"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                            <div class="profile-show-avatar-placeholder"
                                 style="display: none; width: 108px; height: 108px; min-width: 108px; max-width: 108px; min-height: 108px; max-height: 108px;">
                                <i class="ti ti-user"></i>
                            </div>
                        }
                        else
                        {
                            <div class="profile-show-avatar-placeholder"
                                 style="width: 108px; height: 108px; min-width: 108px; max-width: 108px; min-height: 108px; max-height: 108px;">
                                <i class="ti ti-user"></i>
                            </div>
                        }
                    </div>

                    <div>
                        <div class="profile-show-eyebrow">Профіль кандидата</div>
                        <h1>@Show(Model.FullName, "Кандидат")</h1>
                        <div class="profile-show-subtitle">
                            <i class="ti ti-mail"></i>
                            <span>@Show(Model.Email)</span>
                        </div>
                    </div>
                </div>

                <a asp-action="Edit" class="btn btn-primary">
                    <i class="ti ti-edit me-1"></i>
                    Редагувати
                </a>
            </div>

            <div class="profile-show-metrics">
                <div class="profile-show-metric">
                    <i class="ti ti-briefcase"></i>
                    <span>Професійна роль</span>
                    <strong>@Show(Model.Headline)</strong>
                </div>

                <div class="profile-show-metric">
                    <i class="ti ti-map-pin"></i>
                    <span>Місто</span>
                    <strong>@Show(Model.City)</strong>
                </div>

                <div class="profile-show-metric">
                    <i class="ti ti-chart-bar"></i>
                    <span>Досвід</span>
                    <strong>@Model.ExperienceLevel.GetDisplayName() · @experienceYears</strong>
                </div>

                <div class="profile-show-metric">
                    <i class="ti ti-currency-hryvnia"></i>
                    <span>Бажана зарплата</span>
                    <strong>@salary</strong>
                </div>
            </div>

            <div class="profile-show-content">
                <section class="profile-show-section">
                    <h2>Короткий опис</h2>
                    <p>@Show(Model.Summary, "Кандидат ще не додав опис профілю.")</p>
                </section>

                <section class="profile-show-section">
                    <h2>Додаткова інформація</h2>

                    <dl class="profile-show-list">
                        <div>
                            <dt>Роки досвіду</dt>
                            <dd>@Model.ExperienceYears</dd>
                        </div>

                        <div>
                            <dt>Рівень досвіду</dt>
                            <dd>@Model.ExperienceLevel.GetDisplayName()</dd>
                        </div>

                        <div>
                            <dt>Рівень освіти</dt>
                            <dd>@Model.EducationLevel.GetDisplayName()</dd>
                        </div>

                        <div>
                            <dt>Бажана зарплата</dt>
                            <dd>@salary</dd>
                        </div>
                    </dl>
                </section>
            </div>
        </div>
    </div>
</section>