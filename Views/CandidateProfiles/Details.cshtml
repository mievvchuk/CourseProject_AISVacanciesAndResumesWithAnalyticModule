@model CandidateProfileDetailsViewModel

@{
    ViewData["Title"] = "Профіль кандидата";
    string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "Не вказано" : value;
}

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-4 profile-details-head">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                        {
                            <img src="@Model.PhotoPath" alt="@Model.FullName" class="rounded-circle border" style="width: 88px; height: 88px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="profile-avatar profile-avatar-placeholder"><i class="ti ti-user"></i></div>
                        }
                        <div>
                            <h2 class="h4 mb-1">@Model.FullName</h2>
                            <div class="text-muted">@Model.Email</div>
                        </div>
                    </div>
                    <a asp-action="Edit" class="btn btn-primary">Редагувати</a>
                </div>
                <dl class="row mb-0">
                    <dt class="col-sm-4">Професійна роль</dt>
                    <dd class="col-sm-8">@Show(Model.Headline)</dd>
                    <dt class="col-sm-4">Опис</dt>
                    <dd class="col-sm-8">@Show(Model.Summary)</dd>
                    <dt class="col-sm-4">Місто</dt>
                    <dd class="col-sm-8">@Show(Model.City)</dd>
                    <dt class="col-sm-4">Роки досвіду</dt>
                    <dd class="col-sm-8">@Model.ExperienceYears</dd>
                    <dt class="col-sm-4">Рівень досвіду</dt>
                    <dd class="col-sm-8">@Model.ExperienceLevel.GetDisplayName()</dd>
                    <dt class="col-sm-4">Рівень освіти</dt>
                    <dd class="col-sm-8">@Model.EducationLevel.GetDisplayName()</dd>
                    <dt class="col-sm-4">Бажана зарплата</dt>
                    <dd class="col-sm-8">@(Model.DesiredSalary.HasValue ? Model.DesiredSalary.Value.ToString("0.##") : "Не вказано")</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
