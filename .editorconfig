root = true

[*]
insert_final_newline = false
trim_trailing_whitespace = false

[*.{cs,cshtml}]
indent_style = space
indent_size = 4

[*.{json,js,css,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:silent
csharp_prefer_braces = true:silent
